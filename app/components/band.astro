---
interface Props {
  testId?: string;
}

const { testId } = Astro.props;
---
<section class="band" data-testid={testId || undefined}>
  <slot />
</section>

<style lang="scss">
  @use '../styles/tokens/breakpoints' as *;
  @use '../styles/tokens/colors' as *;

  .band {
    @include band-dark;
    background-color: var(--color-paper);
    color: var(--color-ink);

    @media (min-width: $bp-lg) {
      margin-inline: var(--space-5);
      border-radius: var(--radius-lg);
    }
  }

  @media (prefers-color-scheme: dark) {
    .band {
      @include band-light;
    }
  }

  :global([data-theme="light"]) .band {
    @include band-dark;
  }

  :global([data-theme="dark"]) .band {
    @include band-light;
  }
</style>
