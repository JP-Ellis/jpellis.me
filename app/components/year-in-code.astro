---
import type { ActivityItem, GitHubStats } from "../lib/github-stats.ts";
import {
  buildGridLevels,
  dedupCommitsAgainstPrs,
  timeAgo,
} from "../lib/year-in-code.ts";
import Band from "./band.astro";

interface Props {
  stats: GitHubStats;
}

const MAX_RECENT_COMMITS = 6;
const MAX_RECENT_ACTIVITY = 4;

const { stats } = Astro.props;

const now = new Date();
const grid = buildGridLevels(stats);

const dateRange = `${formatPeriod(stats.periodFrom)} — ${formatPeriod(stats.periodTo)}`;

const deduped = dedupCommitsAgainstPrs(stats.recentActivity);
const commits = deduped
  .filter((item) => item.kind === "commit")
  .slice(0, MAX_RECENT_COMMITS);
const issuesPrs = deduped
  .filter((item) => item.kind !== "commit")
  .slice(0, MAX_RECENT_ACTIVITY);

function formatPeriod(dateStr: string): string {
  const d = new Date(`${dateStr}T00:00:00Z`);
  return d.toLocaleDateString("en-US", {
    month: "short",
    year: "numeric",
    timeZone: "UTC",
  });
}

function kindLabel(item: ActivityItem): string {
  if (item.kind === "pull_request") {
    return "PR";
  }
  if (item.kind === "issue") {
    return "issue";
  }
  return "commit";
}

function badge(item: ActivityItem): string {
  const kind = kindLabel(item);
  if (item.state) {
    return `[${kind} · ${item.state}]`;
  }
  return `[${kind}]`;
}
---

<Band testId="year-in-code">
  <div class="container band-inner">
    <div class="band-header">
      <div>
        <h2 class="eyebrow band-label">The year in code</h2>
        <p class="stats-headline">
          <em>{stats.commitContributions}</em> commits, <em>{stats.prContributions}</em> PRs, and <em>{stats.issueContributions}</em> issues across <em>{stats.publicRepos}</em> repositories.
        </p>
      </div>
      <span class="date-range">{dateRange}</span>
    </div>

    <div class="band-intro">
      Most of what I make is open. Each square below is one day of my GitHub
      contributions over the past year.
    </div>

    <div class="commit-grid">
      {
        grid.toReversed().map((col) => (
          <div class="commit-col" data-testid="commit-col">
            {col.map((level) => (
              <span class="commit-cell" data-commit-level={String(level)} />
            ))}
          </div>
        ))
      }
    </div>

    <div class="band-latest">
      <div>
        <h3 class="eyebrow latest-label">Latest commits</h3>
        {
          commits.length === 0 ? (
            <p class="no-activity">No recent commits.</p>
          ) : (
            commits.map((item) => (
              <div class="commit-row" data-testid="commit-row">
                <span class="commit-repo">{item.repo}</span>
                <span class="commit-msg">{item.title}</span>
                <span class="commit-age">{timeAgo(item.createdAt, now)}</span>
              </div>
            ))
          )
        }
      </div>
      <div>
        <h3 class="eyebrow latest-label">Latest issues & PRs</h3>
        {
          issuesPrs.length === 0 ? (
            <p class="no-activity">No recent issues or PRs.</p>
          ) : (
            issuesPrs.map((item) => (
              <div class="activity-row" data-testid="activity-row">
                <div class="activity-repo-wrap">
                  <span class="commit-repo">{item.repo}</span>
                  <span class="activity-kind">{badge(item)}</span>
                </div>
                <span class="commit-msg">{item.title}</span>
                <span class="commit-age">{timeAgo(item.createdAt, now)}</span>
              </div>
            ))
          )
        }
      </div>
    </div>
  </div>
</Band>

<style lang="scss">
  @use "../styles/tokens/breakpoints" as *;

  .band-inner {
    padding-block: var(--space-7);
  }

  .band-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--space-4);

    @media (max-width: $bp-md) {
      flex-direction: column;
      gap: var(--space-2);
    }
  }

  .band-label {
    margin-bottom: var(--space-4);
  }

  .stats-headline {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: var(--text-stat-size);
    margin-top: var(--space-2);
    letter-spacing: var(--text-section-tracking);
  }

  .date-range {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow-size);
    color: var(--color-muted);
  }

  .band-intro {
    margin-bottom: var(--space-5);
    max-width: var(--measure);
    font-size: var(--text-body-size);
    line-height: var(--text-body-leading);
    color: color-mix(in oklch, var(--color-text) 85%, transparent);
  }

  // Columns render newest-first and row-reverse lays them out oldest-first,
  // so an overflowing grid (phones) opens scrolled to the newest week.
  // Auto margins on the edge columns centre the grid when it fits and
  // collapse to zero when it overflows, keeping every week reachable.
  .commit-grid {
    display: flex;
    flex-direction: row-reverse;
    gap: var(--space-half);
    overflow-x: auto;
  }

  .commit-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-half);
    flex-shrink: 0;

    &:first-child {
      margin-inline-end: auto;
    }

    &:last-child {
      margin-inline-start: auto;
    }
  }

  // 13px cells fit 53 weeks across a desktop band; no spacing token fits.
  .commit-cell {
    width: 13px;
    height: 13px;
    border-radius: var(--radius-xs);
    flex-shrink: 0;

    &[data-commit-level="0"] {
      background: var(--color-faint);
    }
    &[data-commit-level="1"] {
      background: color-mix(in oklch, var(--color-accent-soft) 28%, transparent);
    }
    &[data-commit-level="2"] {
      background: color-mix(in oklch, var(--color-accent-soft) 55%, transparent);
    }
    &[data-commit-level="3"] {
      background: color-mix(in oklch, var(--color-accent-soft) 80%, transparent);
    }
    &[data-commit-level="4"] {
      background: var(--color-accent-soft);
    }
  }

  // Repository, message, age. The age column fits "12mo" at meta size.
  .band-latest {
    --row-columns: minmax(0, var(--col-label)) 1fr 40px;

    margin-top: var(--space-6);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-7);

    @media (max-width: $bp-md) {
      grid-template-columns: 1fr;
    }
  }

  .latest-label {
    margin-bottom: var(--space-3);
  }

  .commit-row {
    display: grid;
    grid-template-columns: var(--row-columns);
    gap: var(--space-3);
    padding-block: var(--space-3);
    border-top: 1px solid var(--color-faint);
    align-items: baseline;

    @media (max-width: $bp-md) {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        "repo age"
        "msg  msg";
      gap: var(--space-1) var(--space-3);
    }
  }

  .activity-row {
    display: grid;
    grid-template-columns: var(--row-columns);
    gap: var(--space-3);
    padding-block: var(--space-3);
    border-top: 1px solid var(--color-faint);
    align-items: start;

    @media (max-width: $bp-md) {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        "repo age"
        "msg  msg";
      gap: var(--space-1) var(--space-3);
    }
  }

  .activity-repo-wrap {
    display: flex;
    flex-direction: column;
    gap: var(--space-half);
    overflow: hidden;

    @media (max-width: $bp-md) {
      grid-area: repo;
    }
  }

  .commit-repo {
    font-family: var(--font-mono);
    font-size: var(--text-meta-size);
    color: var(--color-accent);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;

    @media (max-width: $bp-md) {
      grid-area: repo;
    }
  }

  .activity-kind {
    font-family: var(--font-mono);
    font-size: var(--text-meta-size);
    color: var(--color-muted);
  }

  .commit-msg {
    font-family: var(--font-mono);
    font-size: var(--text-meta-size);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;

    @media (max-width: $bp-md) {
      grid-area: msg;
    }
  }

  .commit-age {
    font-family: var(--font-mono);
    font-size: var(--text-eyebrow-size);
    color: var(--color-muted);
    text-align: right;

    @media (max-width: $bp-md) {
      grid-area: age;
    }
  }

  .no-activity {
    padding-block: var(--space-3);
    border-top: 1px solid var(--color-faint);
    font-size: var(--text-body-size);
    color: var(--color-muted);
  }
</style>
