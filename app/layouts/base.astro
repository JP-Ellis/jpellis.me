---
import "../styles/main.scss";
import { ClientRouter } from "astro:transitions";
import { localizedHTML as favicons } from "astro-favicons/middleware";
import Analytics from "../components/analytics.astro";
import Footer from "../components/footer.astro";
import Masthead from "../components/masthead.astro";
import {
  pageTitle,
  SITE_DESCRIPTION,
  SITE_NAME,
  SOCIAL_IMAGE,
} from "../lib/site.ts";

interface Props {
  /** Page name; the home page omits it and is titled with the site name. */
  title?: string;
  description?: string;
  /** Canonical URL, when the page is a copy of one published elsewhere. */
  canonical?: string;
  /** Open Graph type: `article` for posts, `website` otherwise. */
  type?: "website" | "article";
  /** Publication date for articles. */
  published?: Date;
  /** schema.org structured data for the page. */
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description = SITE_DESCRIPTION,
  canonical,
  type = "website",
  published,
  jsonLd,
} = Astro.props;

const site = Astro.site ?? Astro.url;
const fullTitle = pageTitle(title);
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, site).href;
const imageUrl = new URL(SOCIAL_IMAGE, site).href;
// Escapes `<` so post text cannot close the JSON-LD script element.
const jsonLdText = jsonLd && JSON.stringify(jsonLd).replaceAll("<", "\\u003c");
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE_NAME} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    {published && (
      <meta property="article:published_time" content={published.toISOString()} />
    )}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title ?? SITE_NAME} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    {jsonLdText && <script type="application/ld+json" is:inline set:html={jsonLdText} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,100..700;1,9..144,100..600&family=Newsreader:ital,opsz,wght@0,6..72,300..700;1,6..72,300..600&family=Fira+Code:wght@300;400;500;600&display=swap"
    />
    <Fragment set:html={favicons(Astro.currentLocale)} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <ClientRouter />
    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href="/rss.xml" />
    <Analytics />
  </head>
  <body>
    <Masthead />
    <slot />
    <Footer />
  </body>
</html>
